#!/bin/sh
# Corre hackme desde cualquier carpeta con el primer Python 3.11+ que encuentre (o el de
# HACKME_PYTHON). -I: no cargar módulos de la carpeta actual.
cd "$(dirname "$0")/.." || exit 1
PY=""
for p in "${HACKME_PYTHON:-}" python3 python3.14 python3.13 python3.12 python3.11 /opt/homebrew/bin/python3 /usr/local/bin/python3; do
  [ -n "$p" ] && command -v "$p" >/dev/null 2>&1 || continue
  if "$p" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then PY="$p"; break; fi
done
# Si no hay ninguno, sigue con python3 para que `doctor` pueda decirlo.
exec "${PY:-python3}" -I -c 'import runpy, sys; sys.path.insert(0, "."); runpy.run_module("hackme", run_name="__main__")' "$@"
