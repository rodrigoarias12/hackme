#!/usr/bin/env python3
"""bin/avisar "mensaje" — manda un aviso por Telegram.

Lee TELEGRAM_BOT_TOKEN y TELEGRAM_CHAT_ID del ambiente o de ~/.config/hackme/telegram.env
(líneas CLAVE=valor; ese archivo no vive en ningún repo). Sale con código 2 si Telegram no
está configurado, para que quien llama use otro canal.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from hackme.avisar import mandar  # noqa: E402


def main():
    mensaje = " ".join(sys.argv[1:]).strip() or sys.stdin.read().strip()
    if not mensaje:
        sys.exit("uso: bin/avisar \"mensaje\"")
    ok = mandar(mensaje)
    if ok is None:
        print("telegram no configurado (faltan TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID)", file=sys.stderr)
        sys.exit(2)
    print("enviado por telegram" if ok else "telegram falló", file=sys.stdout if ok else sys.stderr)
    sys.exit(0 if ok else 1)


main()
