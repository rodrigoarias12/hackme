#!/bin/sh
# Prepara una sesión en la nube de Claude para correr hackme: baja Aguara del release oficial
# (bin/instalar-aguara verifica el checksum) e imprime la variable que hay que exportar antes
# de `bin/hackme ronda`.
set -eu
RUTA=$("$(dirname "$0")/instalar-aguara")
echo "export HACKME_AGUARA=$RUTA"
