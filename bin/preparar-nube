#!/bin/sh
# Prepara una sesión en la nube de Claude para correr hackme: baja Aguara del release
# oficial, verifica el checksum y refresca su base de amenazas. Imprime las variables que
# hay que exportar antes de `bin/hackme ronda`.
set -eu

VERSION=0.28.0
case "$(uname -m)" in
  x86_64|amd64) ARCH=amd64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  *) echo "arquitectura no soportada: $(uname -m)" >&2; exit 1 ;;
esac

DIR="${HOME}/.local/hackme-bin"
mkdir -p "$DIR"
cd "$DIR"
BASE="https://github.com/garagon/aguara/releases/download/v${VERSION}"
ARCHIVO="aguara_${VERSION}_linux_${ARCH}.tar.gz"
curl -fsSL -o "$ARCHIVO" "$BASE/$ARCHIVO"
curl -fsSL -o checksums.txt "$BASE/checksums.txt"
grep " ${ARCHIVO}\$" checksums.txt | sha256sum -c - >&2
tar -xzf "$ARCHIVO" aguara
"$DIR/aguara" update >&2 || echo "aviso: aguara update falló; sigue con la base embebida" >&2

echo "export HACKME_AGUARA=$DIR/aguara"
